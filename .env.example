# Safaricom Identity (fetchMaskedMsisdn)
# - Works only when the PHONE uses Safaricom mobile data and opens your site over HTTPS.
# - 401 on Wi‑Fi, localhost, or Vite proxy is normal (not a proxy bug).
# VITE_SAFARICOM_IDENTITY_URL=https://identity.safaricom.com/partner/api/v2/fetchMaskedMsisdn
#
# Local UI testing without Safaricom data (dev only):
# VITE_DEV_BYPASS_SAFARICOM=true
# Or open: http://localhost:5174/?safaricom=1  (force pass)  ?safaricom=0  (force fail)
#
# Optional: your backend instead of Safaricom Identity
# VITE_CHECK_CARRIER_URL=https://your-api.com/check-carrier

# Subscribe & pay (https://fast.stargames.co.ke/ pattern)
# VITE_SUBSCRIBE_URL=https://your-api.com/subscribe
# VITE_SUBSCRIPTION_AMOUNT=15
# VITE_SUBSCRIPTION_PERIOD=daily
# VITE_SUBSCRIBE_REDIRECT_URL=https://lyle.pesa.solutions/gameLoader/?game=your-game
